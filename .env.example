# Task Habit Tracker - Environment Variables Example
# 
# このファイルをコピーして .env ファイルを作成し、実際の値を設定してください
# Copy this file to .env and set actual values
#
# 注意: .env ファイルは .gitignore に含まれているため、Gitにコミットされません
# Note: .env file is in .gitignore and will not be committed to Git

# ========================================
# Database Configuration / データベース設定
# ========================================

# PostgreSQL Host
DB_HOST=localhost

# PostgreSQL Port
DB_PORT=5432

# Database Name
DB_NAME=task_habit_tracker

# Database User
DB_USER=your_username

# Database Password
DB_PASSWORD=your_password

# Database URL (Spring Boot format)
# フォーマット: jdbc:postgresql://[HOST]:[PORT]/[DB_NAME]
DATABASE_URL=jdbc:postgresql://localhost:5432/task_habit_tracker

# ========================================
# JWT Configuration / JWT設定
# ========================================

# JWT Secret Key (最低32文字推奨)
# Recommended: at least 32 characters
# 生成方法: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# JWT Token Expiration (ミリ秒)
# Default: 86400000 (24 hours)
JWT_EXPIRATION=86400000

# JWT Refresh Token Expiration (ミリ秒) - Phase 2以降で使用
# Default: 604800000 (7 days)
JWT_REFRESH_EXPIRATION=604800000

# ========================================
# Application Configuration / アプリケーション設定
# ========================================

# Backend Port
PORT=8080

# Application Environment (development, staging, production)
APP_ENV=development

# Log Level (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ========================================
# Frontend Configuration / フロントエンド設定
# ========================================

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Backend API URL (フロントエンドから参照)
REACT_APP_API_URL=http://localhost:8080/api

# ========================================
# CORS Configuration / CORS設定
# ========================================

# Allowed Origins (カンマ区切りで複数指定可能)
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ========================================
# Email Configuration / メール設定
# ========================================
# Phase 2以降で使用予定
# To be used in Phase 2+

# SMTP Host
# SMTP_HOST=smtp.gmail.com

# SMTP Port
# SMTP_PORT=587

# SMTP Username
# SMTP_USERNAME=your_email@gmail.com

# SMTP Password (App Password推奨)
# SMTP_PASSWORD=your_app_password

# Email From Address
# EMAIL_FROM=noreply@taskhabit.com

# ========================================
# External API Keys / 外部APIキー
# ========================================
# Phase 3以降で使用予定
# To be used in Phase 3+

# Weather API Key (OpenWeatherMap)
# WEATHER_API_KEY=your_openweathermap_api_key

# Google Calendar API Key
# GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key

# Firebase Cloud Messaging (Push Notifications)
# FCM_SERVER_KEY=your_fcm_server_key

# ========================================
# File Storage / ファイルストレージ
# ========================================
# Phase 3以降で使用予定
# To be used in Phase 3+

# Storage Type (local, s3, gcs)
# STORAGE_TYPE=local

# Local Storage Path
# STORAGE_LOCAL_PATH=./uploads

# AWS S3 Configuration
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=task-habit-tracker
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ========================================
# Redis Configuration / Redis設定
# ========================================
# Phase 2以降でキャッシング用に使用予定
# To be used for caching in Phase 2+

# Redis Host
# REDIS_HOST=localhost

# Redis Port
# REDIS_PORT=6379

# Redis Password
# REDIS_PASSWORD=

# Redis Database Index
# REDIS_DB=0

# ========================================
# Monitoring & Analytics / モニタリング・分析
# ========================================
# Phase 3以降で使用予定
# To be used in Phase 3+

# Sentry DSN (Error Tracking)
# SENTRY_DSN=your_sentry_dsn

# Google Analytics ID
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# ========================================
# Feature Flags / 機能フラグ
# ========================================

# Enable Swagger/OpenAPI Documentation
ENABLE_SWAGGER=true

# Enable Debug Mode
DEBUG_MODE=false

# Enable Test Data Seeding (開発環境のみ)
# For development only
ENABLE_TEST_DATA=false

# ========================================
# Performance Tuning / パフォーマンスチューニング
# ========================================

# Database Connection Pool Size
DB_POOL_SIZE=10

# Max HTTP Request Size (MB)
MAX_REQUEST_SIZE=10

# Session Timeout (秒)
SESSION_TIMEOUT=3600
